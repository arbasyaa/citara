    <style>
        /* Modern Admin Panel Styles */
        .admin-sidebar-scrollbar::-webkit-scrollbar { width: 6px; }
        .admin-sidebar-scrollbar::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); }
        .admin-sidebar-scrollbar::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 3px; }
        .admin-sidebar-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.3); }
        
        /* Smooth transitions */
        .admin-nav-item { transition: all 0.15s cubic-bezier(0.4, 0, 0.2, 1); }
        .admin-card { transition: box-shadow 0.2s ease; }
        .admin-card:hover { box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
        
        /* Form focus states */
        .admin-input:focus { border-color: #6366f1; ring: 2px; ring-color: rgba(99, 102, 241, 0.2); }
        
        /* Badge animations */
        .admin-badge { animation: fadeIn 0.3s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
        
        /* Mobile sidebar */
        @media (max-width: 1024px) {
            #sidebar { transform: translateX(-100%); transition: transform 0.3s ease; }
            #sidebar.mobile-open { transform: translateX(0); }
        }
    </style>
</head>
