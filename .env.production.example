APP_NAME="Cilacap Tourism and Creative"
APP_ENV=production
APP_KEY=  # GENERATE NEW: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration - CHANGE THESE!
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=citara_production
DB_USERNAME=citara_user  # DO NOT USE root
DB_PASSWORD=  # STRONG PASSWORD REQUIRED
DB_PERSISTENT=true  # Enable connection pooling for better performance

# Session Configuration - SECURE DEFAULTS
SESSION_DRIVER=database
SESSION_LIFETIME=120  # 2 hours for better UX
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com  # Include subdomain support
SESSION_SECURE_COOKIE=true  # HTTPS only

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache Configuration - Use Database for production
CACHE_STORE=database
CACHE_PREFIX=citara_
# For even better performance, use Redis:
# CACHE_STORE=redis
# REDIS_CACHE_DB=1

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.com  # e.g., smtp.mailtrap.io, smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin Panel Password (if using session-based auth)
PANEL_PASSWORD=  # SET A STRONG PASSWORD
